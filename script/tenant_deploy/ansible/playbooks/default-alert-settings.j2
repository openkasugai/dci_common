              notification_settings:
                receiver: email
            - uid: dfar76k1bn6kgb
              title: GPU Power Usage Abnormal
              condition: C
              data:
                - refId: A
                  relativeTimeRange:
                    from: 600
                    to: 0
                  datasourceUid: prometheus
                  model:
                    disableTextWrap: false
                    editorMode: code
