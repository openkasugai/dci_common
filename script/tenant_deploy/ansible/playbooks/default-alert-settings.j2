                - refId: A
                  relativeTimeRange:
                    from: 600
                    to: 0
                  datasourceUid: prometheus
                  model:
                    disableTextWrap: false
                    editorMode: code
                    expr: increase(DCGM_FI_DEV_XID_ERRORS[5m])
