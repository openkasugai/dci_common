                  relativeTimeRange:
                    from: 600
                    to: 0
                  datasourceUid: prometheus
                  model:
                    disableTextWrap: false
                    editorMode: code
                    expr: 'avg_over_time(node_network_up{device!~"lo"}[5m]) '
