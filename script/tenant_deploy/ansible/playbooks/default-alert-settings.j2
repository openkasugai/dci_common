  default-contact-points.yaml: |
    apiVersion: 1
    contactPoints:
        - orgId: 1
          name: email
          receivers:
            - uid: dfaji07p76scgc
              type: email
              settings:
                addresses: {{ alert_email }}
                singleEmail: false
              disableResolveMessage: false
        - orgId: 1
          name: email-and-webhook
          receivers:
            - uid: cfajiybox651da
              type: webhook
              settings:
                httpMethod: POST
                url: http://alertmanager-webhook-logger.default.svc.cluster.local/alerts
              disableResolveMessage: false
            - uid: efajiybox651ce
              type: email
              settings:
                addresses: {{ alert_email }}
                singleEmail: false
              disableResolveMessage: false
